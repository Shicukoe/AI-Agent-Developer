# ── Trello ──────────────────────────────────────────────────────────────────
TRELLO_API_KEY=your_api_key_here
TRELLO_API_TOKEN=your_token_here
# Comma-separated Trello board IDs to monitor
TRELLO_BOARD_IDS=boardId1,boardId2
# Stage lists — card được route theo list nó đang nằm (comma-separated, không phân biệt hoa thường)
# List chứa card epic (feature lớn): lập plan rồi sinh card con khi được chốt
TRELLO_EPIC_LIST_NAMES=Epic
# List "cửa trước": làm rõ & chuẩn hoá task sơ sài trước khi sang Planning/Dev
TRELLO_REFINE_LIST_NAMES=Refine
TRELLO_PLANNING_LIST_NAMES=Planning
TRELLO_DEV_LIST_NAMES=Dev
TRELLO_TEST_LIST_NAMES=Test
TRELLO_INFO_LIST_NAMES=Info
# List đích cho card tài liệu do agent sinh ra (task kind=doc_card). Fallback: Info list rồi list nguồn
TRELLO_DOCS_LIST_NAMES=Docs
# Nhãn bật/tắt agent cho từng card (công tắc). Card phải có nhãn này thì agent mới xử lý.
TRELLO_AI_LABEL_NAME=AI
# Nhãn người dùng gắn để chốt plan ở stage Planning
TRELLO_PLAN_APPROVE_LABEL_NAME=PLAN_APPROVED
# Trello member IDs được phép điều khiển planning qua comment MODIFY/RETRY/REJECT (comma-separated)
ADMIN_TRELLO_MEMBER_IDS=adminId1,adminId2

# ── Webhook vs Polling ───────────────────────────────────────────────────────
# true = webhook mode, false = polling mode
TRELLO_USE_WEBHOOK=false
# Required when USE_WEBHOOK=true — HMAC secret for verifying Trello webhooks
TRELLO_WEBHOOK_SECRET=your_hmac_secret
WEBHOOK_PORT=3456
WEBHOOK_PATH=/webhook/trello
# Polling interval in milliseconds (default 30 seconds)
POLL_INTERVAL_MS=30000

# ── Claude API ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=8096
CLAUDE_MAX_TURNS_PER_TASK=10

# ── Queue ────────────────────────────────────────────────────────────────────
# memory = p-queue (no Redis), redis = BullMQ
QUEUE_BACKEND=memory
# Số phiên chạy đồng thời tối đa (số task xử lý song song)
QUEUE_CONCURRENCY=10
# Only used when QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379

# ── Git ──────────────────────────────────────────────────────────────────────
# Absolute path to the target project repo
GIT_REPO_PATH=D:\Coding_Stuffs\Github\Shicukoe.github.io
# Base directory for git worktrees (outside the repo)
GIT_WORKTREE_BASE=D:\Coding_Stuffs\agent-worktrees
# Branch all task branches are created from
GIT_DEFAULT_BASE_BRANCH=dev
GIT_USER_NAME=AI Agent
GIT_USER_EMAIL=ai-agent@users.noreply.github.com
# GitLab personal access token for pushing branches
GITLAB_TOKEN=glpat-your-token-here

# ── Agent behavior ───────────────────────────────────────────────────────────
# Max parallel Dev Agents for sub-tasks
MAX_SUBTASKS_PARALLEL=3
# Max retry attempts after ReviewAgent FAIL
MAX_DEV_RETRY_ATTEMPTS=2
# Hours before auto-rejecting an unanswered plan approval request
PLAN_APPROVAL_TIMEOUT_HOURS=48
# Minutes before dead man's switch halts a stuck processing task
# Lưu ý: phải >= PLANNING_TIMEOUT_MS (đổi ra phút) để không bị halt giữa lúc đang lập plan
MAX_TASK_PROCESSING_MINUTES=30
# Planning stage — thời gian tối đa cho 1 lần lập plan (ms) và số lượt tool tối đa
PLANNING_TIMEOUT_MS=600000
PLANNING_MAX_TURNS=30

# ── Risk Guard ───────────────────────────────────────────────────────────────
RISK_MAX_ACTIONS_PER_TASK=20
RISK_MAX_COMMENTS_PER_TASK=10
RISK_MAX_CARD_MOVES_PER_TASK=2
# Comma-separated list IDs agent must never move cards into
RISK_FORBIDDEN_LIST_IDS=

# ── Confirmation ─────────────────────────────────────────────────────────────
CONFIRMATION_TIMEOUT_HOURS=24
CONFIRMATION_MAX_REMINDERS=2

# ── Shell ────────────────────────────────────────────────────────────────────
# Comma-separated allowed executable names
SHELL_COMMAND_ALLOWLIST=git,node,npm,npx,tsc,eslint,python
SHELL_TIMEOUT_MS=120000

# ── Claude CLI (DevAgent) ────────────────────────────────────────────────────
# Path to the claude CLI executable. Leave empty to auto-detect.
# Windows example: C:\Users\YourName\AppData\Roaming\npm\claude.cmd
# Find it with: where claude  (or: Get-Command claude in PowerShell)
CLAUDE_CLI_PATH=
# Stream output thật của Claude ra console theo thời gian thực (xem agent đang đọc/ghi/suy luận gì).
# true = thấy chi tiết; false = chỉ thấy status.
AGENT_VERBOSE=true

# ── Admin backend (API + UI tích hợp) ────────────────────────────────────────
# Cổng cho admin server (dashboard quản lý task tại http://<host>:<port>/admin)
ADMIN_PORT=3457
# Token tĩnh bảo vệ admin API. ĐỂ TRỐNG = TẮT admin server. Đặt chuỗi ngẫu nhiên đủ dài để bật.
ADMIN_API_TOKEN=
# Host bind. Mặc định chỉ localhost; đổi 0.0.0.0 nếu cần truy cập từ máy khác (bắt buộc token mạnh).
ADMIN_BIND_HOST=127.0.0.1

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Directory for SQLite database file
DATA_DIR=./data
