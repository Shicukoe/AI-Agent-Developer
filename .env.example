# ── Trello ──────────────────────────────────────────────────────────────────
TRELLO_API_KEY=your_api_key_here
TRELLO_API_TOKEN=your_token_here
# Comma-separated Trello board IDs to monitor
TRELLO_BOARD_IDS=boardId1,boardId2
# Stage lists — card được route theo list nó đang nằm (comma-separated, không phân biệt hoa thường)
# List chứa card epic (feature lớn): lập plan rồi sinh card con khi được chốt
TRELLO_EPIC_LIST_NAMES=Epic
# List "cửa trước": làm rõ & chuẩn hoá task sơ sài trước khi sang Planning/Dev
TRELLO_REFINE_LIST_NAMES=Refine
TRELLO_PLANNING_LIST_NAMES=Planning
TRELLO_DEV_LIST_NAMES=Dev
TRELLO_TEST_LIST_NAMES=Test
TRELLO_INFO_LIST_NAMES=Info
# List đích cho card tài liệu do agent sinh ra (task kind=doc_card). Fallback: Info list rồi list nguồn
TRELLO_DOCS_LIST_NAMES=Docs
# Nhãn bật/tắt agent cho từng card (công tắc). Card phải có nhãn này thì agent mới xử lý.
TRELLO_AI_LABEL_NAME=AI
# Nhãn người dùng gắn để chốt plan ở stage Planning
TRELLO_PLAN_APPROVE_LABEL_NAME=plan approve
# Nhãn "làm luôn" — ép fast-path thẳng Dev (bỏ Refine sâu + Planning)
TRELLO_QUICK_LABEL_NAME=quick
# Nhãn BẬT "BA kỹ thuật": MẶC ĐỊNH refine chỉ chạy BA nghiệp vụ (test chỉ chấm tiêu chí nghiệp vụ).
# Gắn nhãn này lên card khi cần AI phân tích kỹ thuật + sinh tiêu chí/test_cases kỹ thuật.
TRELLO_TECH_REFINE_LABEL_NAME=BA kỹ thuật
# Trello member IDs được phép điều khiển planning qua comment MODIFY/RETRY/REJECT (comma-separated)
ADMIN_TRELLO_MEMBER_IDS=adminId1,adminId2

# ── Webhook vs Polling ───────────────────────────────────────────────────────
# true = webhook mode, false = polling mode
TRELLO_USE_WEBHOOK=false
# Required when USE_WEBHOOK=true — HMAC secret for verifying Trello webhooks
TRELLO_WEBHOOK_SECRET=your_hmac_secret
WEBHOOK_PORT=3456
WEBHOOK_PATH=/webhook/trello
# Polling interval in milliseconds (default 30 seconds)
POLL_INTERVAL_MS=30000

# ── Claude API ───────────────────────────────────────────────────────────────
# Có key → các bước JSON (Refine/Test/Triage) đi API (ổn định). Trống → dùng Claude CLI (cần đăng nhập).
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=8096
CLAUDE_MAX_TURNS_PER_TASK=10

# ── Model routing theo stage ─────────────────────────────────────────────────
# (1) PROVIDER mỗi khâu (claude | gemini | openai):
MODEL_REFINE=claude
MODEL_PLANNING=claude
MODEL_DEV=claude
MODEL_TEST=claude
MODEL_TRIAGE=claude
MODEL_INDEXER=claude
# (2) MODEL-ID cụ thể mỗi khâu — đổi ĐỘC LẬP từng khâu. TRỐNG = dùng model mặc định của provider khâu đó
#     (claude→CLAUDE_MODEL · gemini→GEMINI_MODEL · openai→OPENAI_MODEL).
#     QUAN TRỌNG: model-id phải KHỚP provider. Vd muốn refine bằng Gemini: MODEL_REFINE=gemini + REFINE_MODEL=
#     gemini-2.0-flash. Nếu lỡ để id Claude khi provider=gemini, hệ TỰ thay bằng GEMINI_MODEL (không gửi nhầm).
TRIAGE_MODEL=claude-haiku-4-5-20251001
EPIC_MODEL=claude-opus-4-8
REFINE_MODEL=         # BA + Technical Refiner (provider = MODEL_REFINE). Trống = CLAUDE_MODEL/GEMINI_MODEL…
PLANNING_MODEL=       # Planning thường (provider = MODEL_PLANNING). Epic dùng EPIC_MODEL riêng.
DEV_MODEL=            # Dev khi provider ≠ claude (claude → Claude CLI, không dùng id này)
# REVIEW_MODEL ở mục Test/Review · DOCS_MODEL ở mục Git/gen-docs (đều áp cùng quy tắc khớp-provider).
# Lược bỏ quy ước lặp (CLAUDE.md/overview) ở turn 1+ để tiết kiệm token
OPTIMIZE_HISTORY=true
# (tuỳ chọn) Gemini / OpenAI nếu route sang
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# ── Queue ────────────────────────────────────────────────────────────────────
# memory = p-queue (no Redis), redis = BullMQ
QUEUE_BACKEND=memory
# Số card chạy SONG SONG trong MỖI worker (mỗi repo = 1 worker). Tổng toàn hệ = giá trị này × số repo.
# Nâng để chạy nhiều card cùng lúc (refine/test/dev song song); git được khóa theo repo nên an toàn.
QUEUE_CONCURRENCY=6
# Only used when QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379

# ── Git ──────────────────────────────────────────────────────────────────────
# Absolute path to the target project repo
GIT_REPO_PATH=D:\Coding_Stuffs\Github\Shicukoe.github.io
# Base directory for git worktrees (outside the repo)
GIT_WORKTREE_BASE=D:\Coding_Stuffs\agent-worktrees
# Branch all task branches are created from
GIT_DEFAULT_BASE_BRANCH=dev
GIT_USER_NAME=AI Agent
GIT_USER_EMAIL=ai-agent@users.noreply.github.com
# GitLab personal access token for pushing branches
GITLAB_TOKEN=glpat-your-token-here
# (tuỳ chọn) Override thư mục tài liệu dự án (mặc định <repo>/docs). Refine đọc docs ở đây.
# PROJECT_DOCS_PATH=
# Thời gian tối đa cho 1 lần gen-docs (ms)
GEN_DOCS_TIMEOUT_MS=600000
# Model cho gen-docs (đọc repo + viết tài liệu — khâu quan trọng). Mặc định Opus. API: id; CLI: --model.
DOCS_MODEL=claude-opus-4-8
# gen-docs --deepen ("Đào sâu thêm các docs"): feature doc NHỎ HƠN ngưỡng byte này coi là "mỏng" → viết lại sâu.
# File lớn hơn (đã đầy đủ) giữ nguyên. Nâng lên nếu muốn đào sâu cả các file vừa-vừa.
GEN_DOCS_DEEPEN_MIN_BYTES=6000

# ── Usage (admin: TOKEN THEO KHÂU + % cửa sổ session 5h) ──────────────────────
# Admin hiện: token mỗi khâu (refine/plan/dev/test…) + % tiêu hao session 5h + % tuần.
#
# NGUỒN % 5h (theo thứ tự ưu tiên):
#  1) SỐ THẬT từ Anthropic — gọi /api/oauth/usage bằng OAuth token có sẵn trong ~/.claude/.credentials.json
#     (đúng số `/usage` hiển thị: session 5h + tuần, tự reset, KHÔNG cần trần, KHÔNG bao giờ drift). Token chỉ
#     đọc local + gửi tới api.anthropic.com, KHÔNG log. Hết hạn → mở Claude Code 1 lần để CLI refresh file.
CLAUDE_USAGE_OFFICIAL=true
#  2) ccusage (đọc transcript ~/.claude, ước lượng) — dùng khi (1) lỗi/tắt.
CCUSAGE_ENABLED=true
# Lệnh chạy ccusage. Mặc định npx tự tải. Cài global cho nhanh: npm i -g ccusage → đặt CCUSAGE_CMD=ccusage
CCUSAGE_CMD=npx -y ccusage@latest
USAGE_SESSION_HOURS=5
# Trần token quy %. 0 = TỰ HIỆU CHỈNH theo block 5h cao nhất từ trước (giống ccusage -t max). >0 = ép trần này.
USAGE_SESSION_LIMIT_TOKENS=0

# Lưu ý ĐA-REPO: cấu hình board→repo (path, base branch, docs) qua trang Admin → Repos (lưu DB).
# GIT_REPO_PATH/TRELLO_BOARD_IDS ở trên chỉ là dự án "default" khi CHƯA cấu hình repo nào trong admin.

# ── Agent behavior ───────────────────────────────────────────────────────────
# Max parallel Dev Agents for sub-tasks
MAX_SUBTASKS_PARALLEL=3
# Max retry attempts after ReviewAgent FAIL
MAX_DEV_RETRY_ATTEMPTS=2
# Hours before auto-rejecting an unanswered plan approval request
PLAN_APPROVAL_TIMEOUT_HOURS=48
# Minutes before dead man's switch halts a stuck processing task
# Lưu ý: phải >= PLANNING_TIMEOUT_MS (đổi ra phút) để không bị halt giữa lúc đang lập plan
MAX_TASK_PROCESSING_MINUTES=30
# Planning stage — thời gian tối đa cho 1 lần lập plan (ms) và số lượt tool tối đa
PLANNING_TIMEOUT_MS=600000
PLANNING_MAX_TURNS=30
# Refine (BA/Tech/DocCard) — timeout 1 lần gọi (repo lớn đọc lâu → để rộng). Mặc định 5 phút.
REFINE_TIMEOUT_MS=300000
# Test/Review — reviewer ĐỌC code thật (Read/Glob/Grep) để xác minh, không chỉ đọc diff.
# REVIEW_MODEL: model NẶNG cho review (API: id vd claude-opus-4-8; CLI: tên --model vd opus). Trống = CLAUDE_MODEL.
# REVIEW_MODEL=
REVIEW_MAX_TURNS=25
REVIEW_TIMEOUT_MS=420000
# Kéo-thả / Branch LẦN ĐẦU (chưa có mốc review): chỉ review commit của N NGÀY mới nhất trên nhánh (tránh diff
# cả dải base...branch khổng lồ → chậm/tốn token). Muốn rộng hơn: dev ghi `Base:`/`Range:` trong mô tả card.
REVIEW_AUTODETECT_DAYS=1

# ── Risk Guard ───────────────────────────────────────────────────────────────
RISK_MAX_ACTIONS_PER_TASK=20
RISK_MAX_COMMENTS_PER_TASK=10
RISK_MAX_CARD_MOVES_PER_TASK=2
# Comma-separated list IDs agent must never move cards into
RISK_FORBIDDEN_LIST_IDS=

# ── Confirmation ─────────────────────────────────────────────────────────────
CONFIRMATION_TIMEOUT_HOURS=24
CONFIRMATION_MAX_REMINDERS=2

# ── Shell ────────────────────────────────────────────────────────────────────
# Comma-separated allowed executable names
SHELL_COMMAND_ALLOWLIST=git,node,npm,npx,tsc,eslint,python
SHELL_TIMEOUT_MS=120000

# ── Claude CLI (DevAgent) ────────────────────────────────────────────────────
# Path to the claude CLI executable. Leave empty to auto-detect.
# Windows example: C:\Users\YourName\AppData\Roaming\npm\claude.cmd
# Find it with: where claude  (or: Get-Command claude in PowerShell)
CLAUDE_CLI_PATH=
# Stream output thật của Claude ra console theo thời gian thực (xem agent đang đọc/ghi/suy luận gì).
# true = thấy chi tiết; false = chỉ thấy status.
AGENT_VERBOSE=true

# ── Admin backend (API + UI tích hợp) ────────────────────────────────────────
# Cổng cho admin server (dashboard quản lý task tại http://<host>:<port>/admin)
ADMIN_PORT=3457
# Token tĩnh bảo vệ admin API. ĐỂ TRỐNG = TẮT admin server. Đặt chuỗi ngẫu nhiên đủ dài để bật.
ADMIN_API_TOKEN=
# Host bind. Mặc định chỉ localhost; đổi 0.0.0.0 nếu cần truy cập từ máy khác (bắt buộc token mạnh).
ADMIN_BIND_HOST=127.0.0.1

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Directory for SQLite database file
DATA_DIR=./data
