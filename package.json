{
  "name": "auto-pilot",
  "version": "1.0.0",
  "description": "Multi-agent AI system for Trello-driven task automation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/supervisor.ts",
    "start": "node dist/supervisor.js",
    "gen-docs": "tsx src/scripts/gen-docs.ts",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "node --input-type=module -e \"import { mkdirSync, copyFileSync } from 'fs'; mkdirSync('dist/state', { recursive: true }); mkdirSync('dist/rules', { recursive: true }); copyFileSync('src/state/schema.sql', 'dist/state/schema.sql'); copyFileSync('src/rules/rules.yaml', 'dist/rules/rules.yaml');\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^1.0.0",
    "@anthropic-ai/sdk": "^0.39.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^17.4.2",
    "execa": "^9.5.0",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "p-queue": "^8.0.1",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
